{
  "name": "next-xi",
  "version": "2.4.0",
  "private": true,
  "description": "Evidence-first youth football development workspace",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch server.js",
    "start": "node server.js",
    "test": "node --test --test-isolation=none tests/*.test.js",
    "check": "node scripts/check-syntax.js",
    "export": "node scripts/export-standalone.js",
    "export:review": "node scripts/export-review.js",
    "export:training": "node scripts/export-training.js",
    "test:review": "python tests/review-browser.py",
    "test:training-sync": "python tests/training-cloud-browser.py",
    "test:training": "python tests/training-browser.py",
    "test:sync": "python tests/sync-browser.py",
    "test:browser": "python tests/growth-browser.py",
    "test:chat-pack": "python tests/chat-pack-browser.py",
    "test:video-clips": "python tests/video-clips-browser.py",
    "test:feedback": "python tests/feedback-browser.py"
  },
  "dependencies": {
    "@netlify/blobs": "^11.1.4",
    "ffmpeg-static": "^5.3.0"
  }
}
